POSTGRES_CONTAINER_NAME=neurobank
POSTGRES_DB=neurobank
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=neurobank_postgres
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5432
POSTGRES_DATA_PATH=/var/lib/postgresql
POSTGRES_VOLUME_NAME=neurobank_data
POSTGRES_NETWORK_NAME=neurobank_network
POSTGRES_INITDB_ARGS=--encoding=UTF8 --lc-collate=en_US.UTF-8 --lc-ctype=en_US.UTF-8

TZ=Europe/London